# Copy this file to config.sh and fill in values.
# config.sh is gitignored so secrets stay local.

# Recipe generator: "codex" (default, GPT via Codex CLI) or "claude".
# For Codex, install a current CLI and run `codex login` with your ChatGPT account.
# RECIPE_PROVIDER="codex"

# Optional model override supported by the selected provider.
# Unset or empty: Codex uses gpt-5.6-luna; Claude uses its CLI's default model.
# Codex recipe runs skip ~/.codex/config.toml; set the model here if desired.
# RECIPE_MODEL="gpt-5.6-luna"

# Discord webhook URL for --notify discord.
# Create one in Discord: Server Settings → Integrations → Webhooks → New Webhook.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/XXXX/YYYY"

# Discord bot — needed only for bot/index.js.
# Create the bot in https://discord.com/developers/applications, then:
#   - Bot tab: Reset Token, paste below
#   - General Information tab: copy the Application ID
#   - In Discord (with Developer Mode on): right-click your server icon → Copy Server ID
# DISCORD_BOT_TOKEN="..."
# DISCORD_APPLICATION_ID="..."
# DISCORD_GUILD_ID="..."

# Natural-language Discord requests: mention the bot in the configured guild.
# Enabled by default; false disables the message listener (slash commands still work).
# DISCORD_NL_ENABLED="true"
# Codex model for interpreting commands, independent of the recipe provider/model.
# DISCORD_NL_MODEL="gpt-5.6-luna"
# Optional comma-separated Discord user IDs allowed to use natural-language requests.
# Unset or empty allows everyone in the configured guild who mentions the bot.
# DISCORD_NL_ALLOWED_USER_IDS="123456789012345678"

# Output language for generated recipes. Free-form string passed to the LLM.
# Examples: "Korean", "Japanese", "Italian", "日本語".
# Unset or empty → English (default).
# RECIPE_LANGUAGE="Korean"
